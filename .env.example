# Settings for the new python -m smart_display entry point.
# Optional window size overrides; leave blank to size from the current display.
DISPLAY_WIDTH=
DISPLAY_HEIGHT=
FULLSCREEN=false
TEXT_FONT=Arial Rounded MT Bold
# system tracks the desktop; light and dark select a fixed appearance.
DISPLAY_THEME=system
# Weather is optional.
WEATHER_API_KEY=
WEATHER_LOCATION=
# Instagram is optional. Explicitly select a supported Graph API version.
GRAPH_API_VERSION=
IG_BUSINESS_USER_ID=
ACCESS_TOKEN=
ACCESS_TOKEN_EXPIRY=
